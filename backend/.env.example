# ============ 网关(OpenAI 兼容接口,对话与 Embedding 共用)============
API_KEY=sk-your-api-key
BASE_URL=https://tokendance.space/gateway/v1

# ============ 对话模型============
MODEL_FLASH=deepseek-v4-flash
MODEL_PRO=deepseek-v4-pro
MODEL_GLM=glm-5.2

# ============ Embedding============
EMBEDDING_MODEL=qwen-text-embedding-v4

# ============ TTS============
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE=苏打

# ============ ASR============
ASR_PROVIDER=local
ASR_MODEL=medium
ASR_DEVICE=cpu
ASR_BASE_URL=
ASR_API_KEY=
ASR_LANGUAGE=zh

# ============ 应用============
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
DEMO_MODE=false

# ============ 数据============
DATABASE_URL=sqlite+aiosqlite:///./data/interview.db
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
DEFAULT_RETENTION_DAYS=30
PII_REDACTION_ENABLED=true

# 每百万 token 估算成本（请按实际网关价格调整）
COST_FLASH_INPUT_PER_MILLION=0.2
COST_FLASH_OUTPUT_PER_MILLION=0.8
COST_PRO_INPUT_PER_MILLION=1.0
COST_PRO_OUTPUT_PER_MILLION=4.0
COST_GLM_INPUT_PER_MILLION=2.0
COST_GLM_OUTPUT_PER_MILLION=8.0

# ============ CORS============
# Railway 部署后填写前端公网域名，例如 https://interview-frontend.up.railway.app
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Reliability: keyword retrieval works without a separate embedding service.
RAG_VECTOR_ENABLED=false
# Set true only after configuring a compatible embedding provider.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
RAG_TIMEOUT_SECONDS=4
CHAT_FIRST_TOKEN_SECONDS=12
CHAT_TOTAL_SECONDS=45
TTS_TIMEOUT_SECONDS=6
