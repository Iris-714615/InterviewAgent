# ============ LLM 配置(OpenAI 兼容接口)============
# 可填 OpenAI / GLM / Qwen / DeepSeek 等兼容接口
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============ TTS 语音模型 ============
# mimo-v2.5-tts 预置音色:冰糖/茉莉(女) 苏打/白桦(男) Mia/Chloe(女) Milo/Dean(男)
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE=苏打

# ============ ASR 语音识别 ============
# provider: local=本地faster-whisper(免费,默认) / api=OpenAI兼容接口
ASR_PROVIDER=local
# 本地模式模型大小:tiny/base/small/medium/large-v3(中文推荐 medium)
ASR_MODEL=medium
# 本地模式设备:cpu / cuda(有N卡可改cuda加速)
ASR_DEVICE=cpu
# API 模式端点(留空复用 BASE_URL;如网关不支持ASR可填独立端点)
ASR_BASE_URL=
ASR_API_KEY=
# 识别语言:zh=中文,en=英文,留空自动检测
ASR_LANGUAGE=zh

# ============ 应用配置 ============
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ============ 数据库 ============
DATABASE_URL=sqlite+aiosqlite:///./data/interview.db

# ============ 向量库 ============
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-api-key

# ============ 上传目录 ============
UPLOAD_DIR=./data/uploads

# ============ CORS ============
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
